PORT=5000
NODE_ENV=development
MONGO_URI=mongodb://127.0.0.1:27017/preowned_tech_companion
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=7d
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=llama3.1
OLLAMA_EMBED_MODEL=nomic-embed-text
EMBEDDING_TIMEOUT_MS=15000
# Optional: origin of a separate frontend (CORS). Defaults to http://localhost:5173
CLIENT_URL=http://localhost:5173
# Set to true ONLY when using MongoDB Atlas with vector indexes
# (listing_vector_index / specification_chunk_vector_index). Otherwise dev uses local cosine scoring.
ATLAS_VECTOR_SEARCH_ENABLED=false
# Optional: allow seed script to wipe non-localhost databases
ALLOW_REMOTE_SEED=false

# Mailer configuration (Required in production for email verification and password resets)
# In development, emails are automatically logged to console stream if SMTP is omitted
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
FROM_EMAIL="Preowned Tech Companion <noreply@preownedtech.local>"

